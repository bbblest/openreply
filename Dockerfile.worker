# Railway background worker. Set RAILWAY_DOCKERFILE_PATH=Dockerfile.worker.
# The web app is deployed separately to Vercel.
FROM node:22-bookworm-slim
WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Keep dev dependencies: the worker runs TypeScript through tsx.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY prisma ./prisma
COPY prisma.config.ts tsconfig.json ./
RUN npm run db:generate

COPY lib ./lib
COPY worker ./worker

ENV NODE_ENV=production
USER node
CMD ["npm", "run", "worker"]
